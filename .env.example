APP_NAME="Healthcare Voice Agent API"
ENVIRONMENT=development
DEBUG=true

HOST=127.0.0.1
PORT=8000

# JSON list or comma-separated origins allowed by CORS
CORS_ORIGINS=["http://localhost:3000"]

# --- Database -------------------------------------------------------------
# Host "localhost" when running the app directly; docker-compose overrides
# this to host "db" for the api container.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/healthcare_voice_agent
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# --- docker-compose -------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=healthcare_voice_agent
POSTGRES_PORT=5432
API_PORT=8000

# --- Secrets --------------------------------------------------------------
# Keep real values in .env only; never commit them.
OPENAI_API_KEY=

# --- Vapi -----------------------------------------------------------------
# Shared secret. Add the same key/value under
# Phone Number -> Authorization -> HTTP Headers in the Vapi dashboard.
VAPI_SECRET=
VAPI_SECRET_HEADER=x-vapi-secret

# Public HTTPS URL Vapi can reach. In development this is your ngrok URL.
PUBLIC_BASE_URL=https://your-subdomain.ngrok-free.app

VAPI_MODEL_PROVIDER=openai
VAPI_MODEL=gpt-4o
VAPI_VOICE_PROVIDER=vapi
VAPI_VOICE_ID=Elliot

# --- Logging --------------------------------------------------------------
LOG_LEVEL=INFO
# Logs full webhook request/response bodies. These contain patient names and
# dates of birth (PHI) - keep false anywhere real calls land.
LOG_PAYLOADS=false

# Spoken in the voice agent's greeting.
CLINIC_NAME="Bilal's Clinic"
